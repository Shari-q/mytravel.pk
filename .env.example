# =========================================================================
# MYTRAVEL.PK - ENVIRONMENT & INTEGRATION CONFIGURATION
# =========================================================================

# ASP.NET Core Hosting Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5200;https://+:5201

# Database Configuration (Choose 'Sqlite' or 'SqlServer')
DATABASE_PROVIDER=Sqlite
SQL_SERVER_CONNECTION="Server=localhost;Database=MyTravelDb;User Id=sa;Password=YourSecurePassword123!;MultipleActiveResultSets=true;TrustServerCertificate=True"
SQLITE_CONNECTION="Data Source=../database/mytravel.db"

# JWT Security Secrets
JWT_SECRET=MyTravelSuperSecretKey2026_SecureHashingToken_984128
JWT_ISSUER=https://mytravel.pk
JWT_AUDIENCE=https://mytravel.pk
JWT_EXPIRY_DAYS=7

# Verified Company Identity
COMPANY_NAME=MyTravel.pk
SUPPORT_PHONE=03111-101-365
WHATSAPP_NUMBER=+923111101365
SUPPORT_EMAIL=hello@mytravel.pk
HEAD_OFFICE="Office No. 310, Al-Hafeez Business Center, 89-A Block B3, Firdous Market Road, Gulberg-III, Lahore, Pakistan"
DTS_LICENSE="Department of Tourist Services (DTS)"
IATA_TIDS="IATA TIDS Accredited Member"

# External Flight GDS Adapter Configuration (Amadeus / Sabre / Demo)
FLIGHT_PROVIDER=DemoAdapter
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
AMADEUS_ENV=production # or test

# Insurance Partner API Integration (Adamjee / United Insurance)
INSURANCE_PROVIDER=AdamjeeUnitedAdapter
ADAMJEE_PARTNER_API_KEY=your_adamjee_partner_key
UIC_PARTNER_API_KEY=your_uic_partner_key

# Payment Gateway Configuration (Bank Alfalah / PayFast / Stripe)
PAYMENT_GATEWAY=DemoGateway
PAYMENT_MERCHANT_ID=your_merchant_id
PAYMENT_STORE_KEY=your_store_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Cloudflare & Domain
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_token
PRIMARY_DOMAIN=mytravel.pk
